# API Base URL (Server-side)
API_BASE_URL=https://api.rapharch.com.au

# API Base URL (Client-side)
NEXT_PUBLIC_API_BASE_URL=https://api.rapharch.com.au

# Revalidation Secret - CHANGE THIS in production!
REVALIDATE_SECRET=change-this-to-a-secure-random-secret

# Stripe Publishable Key - set your actual key here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# Other environment variables
NODE_ENV=development
