# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:9999

# Application
NODE_ENV=development

# Cookie Domain (for cross-origin admin/api deployment, e.g., "yourdomain.com")
# Leave empty for localhost/same-origin
NEXT_PUBLIC_COOKIE_DOMAIN=

# Sentry - Performance & Error Monitoring
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=admin
