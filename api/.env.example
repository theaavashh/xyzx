# Database (MySQL)
DATABASE_URL="mysql://rapharch:rapharch@localhost:3306/rapharch"
DATABASE_URL_PRIMARY="mysql://rapharch:rapharch@localhost:3306/rapharch"
DATABASE_URL_REPLICA="mysql://rapharch:rapharch@localhost:3306/rapharch"

# JWT Configuration
JWT_SECRET=jwt_secret_key_here
JWT_REFRESH_SECRET=refresh_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Configuration
# Replace with actual rapharch key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_RapharchKey

# Stripe Webhook Secret 
STRIPE_WEBHOOK_SECRET=WEBHOOK_SECRET_HERE

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=app_password
SMTP_FROM=sales@rapharch.com


#Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# Server Configuration
PORT=9999
GRPC_PORT=50051
NODE_ENV=development
API_URL=http://localhost:9999
PRODUCTION_API_URL=https://api.yourdomain.com
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cache Configuration
# Multi-Level Cache Settings
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=600
CACHE_CHECK_PERIOD=60

# L1 Cache (In-Memory) Settings
L1_CACHE_SIZE=1000
L1_CACHE_TTL=60

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
