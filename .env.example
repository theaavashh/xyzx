# Required - Database
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=rapharch
MYSQL_USER=rapharch
MYSQL_PASSWORD=your_secure_db_password

# Required - Redis
REDIS_PASSWORD=your_secure_redis_password

# Required - JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Required - Admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAIL=admin@rapharch.com
ADMIN_NAME=Admin

# Required - Email (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=RaphArch <noreply@rapharch.com>

# Required - Payments (Stripe)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Required - URLs
FRONTEND_URL=https://rapharch.com
ADMIN_URL=https://admin.rapharch.com
NEXT_PUBLIC_API_BASE_URL=https://api.rapharch.com
NEXT_PUBLIC_SITE_URL=https://rapharch.com

# Optional
USE_REDIS=true

# Monitoring (Grafana / Prometheus)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d
