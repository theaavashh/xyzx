# ==========================================
# REQUIRED - Generate unique values for production.
# Never use these placeholder values in production.
# ==========================================

# Database
MYSQL_ROOT_PASSWORD=CHANGE_ME_to_a_secure_password
MYSQL_DATABASE=rapharch
MYSQL_USER=rapharch
MYSQL_PASSWORD=CHANGE_ME_to_a_secure_password

# Redis
REDIS_PASSWORD=CHANGE_ME_to_a_secure_password

# JWT - Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# Admin - Required for auto-create scripts
ADMIN_PASSWORD=CHANGE_ME_to_a_secure_password_min_8_chars
ADMIN_EMAIL=admin@rapharch.com
ADMIN_NAME=Admin

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=RaphArch <noreply@rapharch.com>

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# URLs
FRONTEND_URL=https://rapharch.com
ADMIN_URL=https://admin.rapharch.com
NEXT_PUBLIC_API_BASE_URL=https://api.rapharch.com
NEXT_PUBLIC_SITE_URL=https://rapharch.com

# Optional
USE_REDIS=true

# Monitoring (Grafana / Prometheus) - set these via environment, never defaults
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_RETENTION=15d

# Metrics protection - optional, falls back to API_KEY
METRICS_API_KEY=CHANGE_ME
